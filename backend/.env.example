# Copy to .env and adjust. Every value has a sensible default.

# SQLite database file (relative to backend/)
GG_DATABASE_PATH=data/jobs.db

# Scraper politeness
GG_SCRAPER_MIN_DELAY=1.5
GG_SCRAPER_MAX_DELAY=3.5
GG_SCRAPER_TIMEOUT=20
GG_SCRAPER_MAX_RETRIES=3

# Frontend origins allowed by CORS (comma separated)
GG_CORS_ORIGINS=http://localhost:5173

# Optional: enables the Claude-powered resume match. Without it the offline matcher is used.
ANTHROPIC_API_KEY=
